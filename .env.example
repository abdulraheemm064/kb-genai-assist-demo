# Optional LLM provider. Disabled unless KB_ASSIST_LLM_ENABLED=true.
# Copy to .env and fill in from your secret store. Never commit .env.
KB_ASSIST_LLM_ENABLED=false
KB_ASSIST_LLM_ENDPOINT=https://your-approved-ai-gateway.example/v1/chat/completions
KB_ASSIST_LLM_API_KEY=replace-with-key-from-your-secret-store
KB_ASSIST_LLM_MODEL=replace-with-model-name
